# =====================================================================
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# =====================================================================

# ---- Supabase ------------------------------------------------------
# Dashboard -> your project -> Project Settings -> API
#
# You only need the URL and the SECRET key. The publishable key is the
# browser-safe one and is NOT used by this backend; the JWKS URL is only
# needed if you used Supabase Auth to verify tokens, which this app does
# not (it issues its own JWTs).
#
# The secret key bypasses Row Level Security, so it must ONLY ever be
# used server-side. Never prefix it with VITE_ or it ships to browsers.
#
# Naming: older projects call this `service_role` (a JWT). Newer ones call
# it the "Secret key" and it starts with sb_secret_. Identical powers.
# SUPABASE_SECRET_KEY is the only accepted variable name.
# Do NOT also define SUPABASE_SERVICE_ROLE_KEY: nothing reads it, and having
# both set makes it look like the key is configured when it is not.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Bucket names (create these in Supabase -> Storage).
# posts, avatars and stories should be PUBLIC so the CDN can serve
# them. messages should be PRIVATE (accessed via signed URLs).
SUPABASE_BUCKET_POSTS=posts
SUPABASE_BUCKET_AVATAVARS=avatars
SUPABASE_BUCKET_STORIES=stories
SUPABASE_BUCKET_MESSAGES=messages

# ---- Database ------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string
#
# OPTION A - DIRECT CONNECTION (recommended for a long-running backend)
#   Host is db.<ref>.supabase.co, port 5432.
#   Prepared statements work normally. ~15 connection cap on free tier,
#   so leave DB_POOL_SIZE at 5.
#
#   DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
#   DATABASE_USERNAME=postgres
#
# OPTION B - CONNECTION POOLER, transaction mode
#   Host is aws-0-<region>.pooler.supabase.com - note it is NOT
#   db.<ref>.supabase.co. Port 6543.
#   Transaction mode cannot do prepared statements, so
#   DB_PREPARE_THRESHOLD must stay 0.
#
#   DATABASE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
#   DATABASE_USERNAME=postgres.your-project-ref
#
# sslmode=require is mandatory either way.
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password
DB_POOL_SIZE=5

# 0 = prepared statements off (required for the 6543 pooler).
# Set to -1 for a faster direct connection.
DB_PREPARE_THRESHOLD=0

# ---- Security ------------------------------------------------------
# Generate a real one for production:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# ---- CORS ----------------------------------------------------------
# Comma-separated. Must include your deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Media limits (bytes) -----------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=15728640
MAX_AVATAR_BYTES=5242880
MAX_STORY_VIDEO_BYTES=20971520

# ---- Server --------------------------------------------------------
SERVER_PORT=8080
