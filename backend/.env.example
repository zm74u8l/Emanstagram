# =====================================================================
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# =====================================================================

# ---- Media storage -------------------------------------------------
# supabase = Supabase Storage (free tier: 5 GB/month egress)
# s3       = any S3-compatible store. Cloudflare R2 has NO egress fees.
STORAGE_PROVIDER=supabase

# ---- Cloudflare R2 / S3 (when STORAGE_PROVIDER=s3) -------------------
# R2 dashboard -> R2 -> Manage API tokens -> Create API token
#   (Object Read & Write, scoped to the two buckets below).
# The endpoint is shown on the token page: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket: posts/, avatars/, stories/. Turn on public access for it.
S3_PUBLIC_BUCKET=emanstagram-media
# Private bucket: chat attachments, only reachable through signed links.
S3_PRIVATE_BUCKET=emanstagram-private
# Where browsers load public media from: your custom domain connected to the
# public bucket (recommended), or its r2.dev URL for testing.
S3_PUBLIC_BASE_URL=https://media.your-domain.com
S3_PATH_STYLE=true

# ---- Supabase ------------------------------------------------------
# Dashboard -> your project -> Project Settings -> API
#
# The secret key bypasses Row Level Security, so it must ONLY ever be
# used server-side. Never prefix it with VITE_ or it ships to browsers.
# New projects use sb_secret_...; older ones still show the legacy
# service_role JWT. Both have identical privileges.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Supabase Storage bucket names (only used when STORAGE_PROVIDER=supabase;
# create them in Supabase -> Storage).
# posts, avatars and stories should be PUBLIC so the CDN can serve
# them. messages should be PRIVATE (accessed via signed URLs).
SUPABASE_BUCKET_POSTS=posts
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_STORIES=stories
SUPABASE_BUCKET_MESSAGES=messages

# ---- Database ------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string
#
# OPTION A - DIRECT CONNECTION (recommended for a long-running backend)
#   Host is db.<ref>.supabase.co, port 5432.
#   Prepared statements work normally. ~15 connection cap on free tier,
#   so leave DB_POOL_SIZE at 5.
#
#   DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
#   DATABASE_USERNAME=postgres
#
# OPTION B - CONNECTION POOLER, transaction mode
#   Host is aws-0-<region>.pooler.supabase.com - note it is NOT
#   db.<ref>.supabase.co. Port 6543.
#   Transaction mode cannot do prepared statements, so
#   DB_PREPARE_THRESHOLD must stay 0.
#
#   DATABASE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
#   DATABASE_USERNAME=postgres.your-project-ref
#
# sslmode=require is mandatory either way.
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password
DB_POOL_SIZE=5

# 0 = prepared statements off (required for the 6543 pooler).
# Set to -1 for a faster direct connection.
DB_PREPARE_THRESHOLD=0

# ---- Security ------------------------------------------------------
# Generate a real one for production:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# ---- CORS ----------------------------------------------------------
# Comma-separated. Must include your deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Abuse protection ----------------------------------------------
# Cloudflare dashboard -> Turnstile -> Add widget. Leave both empty to skip
# the sign-up bot check (fine locally, not in production).
# For local testing, Cloudflare's always-pass test keys work:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 0 locally. 1 on Railway/Render/Fly (one proxy in front of the app).
# Check it after deploying: GET /api/public/ip must show YOUR public IP.
TRUSTED_PROXY_HOPS=0

# Leave on. Only for debugging.
RATE_LIMITS_ENABLED=true

# Upload budgets (bytes). Defaults shown; only set these to change them.
# STORAGE_QUOTA_BYTES=1073741824              # 1 GB per account
# DAILY_UPLOAD_BYTES=209715200                # 200 MB per 24 h
# DAILY_UPLOAD_COUNT=50                       # files per 24 h
# NEW_ACCOUNT_DAILY_UPLOAD_BYTES=52428800     # 50 MB in the first day
# NEW_ACCOUNT_DAILY_UPLOAD_COUNT=15
# NEW_ACCOUNT_PERIOD=PT24H

# ---- Media limits (bytes) -----------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=15728640
MAX_AVATAR_BYTES=5242880
MAX_STORY_VIDEO_BYTES=20971520

# ---- Server --------------------------------------------------------
SERVER_PORT=8080
