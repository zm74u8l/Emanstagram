# =====================================================================
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# =====================================================================

# ---- Supabase ------------------------------------------------------
# Project Settings -> API
# NOTE: the service role key is a SECRET. It must only ever appear in
# backend env vars. Never prefix it with VITE_ or it ships to browsers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bucket names (create these in Supabase Storage)
SUPABASE_BUCKET_POSTS=posts
SUPABASE_BUCKET_AVATAVARS=avatars
SUPABASE_BUCKET_STORIES=stories
SUPABASE_BUCKET_MESSAGES=messages

# ---- Database ------------------------------------------------------
# Supabase Settings -> Database -> Connection string
#
# IMPORTANT: use the Supavisor POOLER URL (port 6543, db.<ref>.supabase.co)
# rather than the direct connection (port 5432, db.<ref>.supabase.co).
# The direct connection has a low connection cap that a long-lived Spring
# pool will exhaust in production.
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:6543/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-db-password
DB_POOL_SIZE=10

# ---- Security ------------------------------------------------------
# Generate a real one for production:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# ---- CORS ----------------------------------------------------------
# Comma-separated. Must include your deployed frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Media limits (bytes) -----------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=15728640
MAX_AVATAR_BYTES=5242880
MAX_STORY_VIDEO_BYTES=20971520

# ---- Server --------------------------------------------------------
SERVER_PORT=8080
