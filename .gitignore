# ---- build output ----
target/
build/
!target/**/*.jar.original

# ---- node ----
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- environment / secrets ----
# Never commit real credentials. Copy .env.example to .env and fill in.
.env
.env.local
.env.*.local
!.env.example

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
.DS_Store
Thumbs.db

# ---- local toolchain ----
# Maven is vendored under tools/ so the build works without a global install
tools/
mvnw
mvnw.cmd
.mvn/wrapper/maven-wrapper.jar

# ---- logs ----
*.log
logs/

# TypeScript incremental build info
*.tsbuildinfo
